source "Kconfig.zephyr"

menu "E-ink tag firmware"

config BT_NUS_SECURITY_ENABLED
	bool "Require link-layer security on the NUS characteristics"
	default n
	select BT_SMP
	help
	  Gate the Nordic UART Service behind BLE pairing. Off by default:
	  SMP plus P-256 ECDH costs roughly 31 KB of flash and 6.4 KB of RAM,
	  which the mesh scanner needs, and access is already gated by the
	  app-level challenge-response in src/app/secauth.c.

config EINK_FRAME_ARENA_BYTES
	int "Frame-buffer arena size, bytes"
	default 15000
	help
	  Static .bss arena that display_manager carves the frame planes out of
	  at boot, sized for the largest panel this image can drive.

	    15000 - 400x300 B/W, one plane. Also covers the 128x296 B/W/R pair
	            (2 x 4736 = 9472), so a single image drives both panels.
	     9472 - 128x296 B/W/R only. Frees 5528 bytes of RAM, several times
	            the headroom this build otherwise has.

	  The cost of shrinking it is not a crash: graphics_init_panel() refuses
	  a layout that does not fit and detect_panel() falls back to 128x296, so
	  a 400x300 panel would be driven as if it were the small one - a wrong
	  picture. Only shrink this for a fleet you know has no 400x300 panels,
	  and build the large panel its own image.

config SETTINGS
	default y

config ZMS
	default y if (SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)

config NVS
	default y if !(SOC_FLASH_NRF_RRAM || SOC_FLASH_NRF_MRAM)

endmenu
